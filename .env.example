# The only variable the app itself reads. User, password, host, port and
# database name all live inside this one connection string.
# (If the password contains @ / : ? or #, percent-encode it.)
DATABASE_URL=postgres://shopping:shopping@localhost:5432/shopping

# Only used by docker-compose.yml, to initialise the Postgres container it
# starts. Not read by the app. Not needed at all if you point DATABASE_URL at
# a database you manage elsewhere — e.g. Dokploy's own Postgres service.
POSTGRES_PASSWORD=change-me
