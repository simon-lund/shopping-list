# --- Core app ------------------------------------------------------------
# Point the app at Postgres either way round.
#
# A connection string — handy locally and for hosted providers. Note that a
# password containing / # or ? must be percent-encoded or the URL won't parse.
DATABASE_URL=postgres://shopping:shopping@localhost:5432/shopping
#
# ...or the standard discrete variables, which `pg` reads on its own and which
# need no escaping, so any password works as typed. DATABASE_URL wins if both
# are set. docker-compose.yml uses these.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=shopping
# PGPASSWORD=
# PGDATABASE=shopping

# Public origin, used for the links the WhatsApp bot posts into the group.
PUBLIC_URL=https://list.example.com

# Enables the guarded health check at /api/health. Any random string; the
# endpoint 404s until this is set. Send it as `Authorization: Bearer <token>`
# or, for monitors that can't set headers, as ?token=<token>.
HEALTH_TOKEN=
# Include WhatsApp group ids and names in /api/health. Off by default: that is
# private metadata, and it would otherwise sit behind the same single token.
# Turn on while you populate ALLOWED_GROUPS, then turn it off.
HEALTH_SHOW_GROUPS=

# --- Compose only ----------------------------------------------------------
# Initialises the Postgres container docker-compose.yml starts. Not read by
# the app. Unused if DATABASE_URL points at a database you manage elsewhere.
POSTGRES_PASSWORD=change-me
# Hostname Traefik routes to the app service.
DOMAIN=list.example.com

# --- WhatsApp bot (optional) -----------------------------------------------
# Leave these unset to run the list without the bot; the webhook route then
# simply rejects everything and nothing else changes.
ANTHROPIC_API_KEY=sk-ant-...
# Defaults to claude-haiku-4-5. Set claude-opus-5 for better judgement on
# messages that only sound like shopping, at roughly five times the cost.
CLAUDE_MODEL=

# --- Cloud API transport (Meta's official Groups API) ----------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; you type the same value into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app dashboard. Used to verify webhook signatures —
# without it every webhook is rejected, which is the safe default.
WHATSAPP_APP_SECRET=
# Override only if Meta moves on from the default Graph API version.
WHATSAPP_API_VERSION=

# --- Baileys transport (unofficial, works in an existing group) ------------
# Shared secret between the worker and the app's /api/bot endpoint. Any random
# string. Only needed if you run the baileys compose profile.
BOT_SHARED_SECRET=
# Groups the bot may act in, comma-separated. Deny-by-default: leave this empty
# and it responds nowhere. Send a message in the group, then read the JID out
# of the worker logs and paste it here.
ALLOWED_GROUPS=
# Required for the baileys worker: the number to link, digits only with country
# code, no + or spaces. The worker logs an 8-character pairing code for it.
# Ignored once a session exists.
BAILEYS_PAIR_NUMBER=
# Set to true when pairing your own number rather than a spare one, so the bot
# reacts to what you type too. Its own replies are still skipped, by id.
BAILEYS_INCLUDE_OWN_MESSAGES=
# Require a prefix before the bot looks at a message, e.g. "+" so that
# "+milk" is a request and ordinary chat is not. Unset means every text
# message in an allowed group is sent to the model. Filtering happens in the
# worker, so a non-matching message never leaves your server.
BOT_TRIGGER=
# Skip messages longer than this many characters (default 500).
BOT_MAX_CHARS=
